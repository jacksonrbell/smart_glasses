SHEET 1 1376 800
TEXT 32 80 Left 2 !.param VBAT=3.7 RBAT=0.15 GAIN=9 RLOAD=8 EFF=0.88 IQ=2.4m DROP=0.19\n.param VFS={sqrt(2)*pow(10,(2.1+GAIN)/20)}\nV_IN   in    0    PWL file=test_compressed_pwl.txt\nV_BATT bat0  0    {VBAT}\nR_BATT bat0  bat  {RBAT}\nB_L    outL  0    V=limit({VFS}*V(in), -(V(bat)-{DROP}), V(bat)-{DROP})\nR_L    outL  0    {RLOAD}\nB_R    outR  0    V=limit({VFS}*V(in), -(V(bat)-{DROP}), V(bat)-{DROP})\nR_R    outR  0    {RLOAD}\nB_BAT  bat   0    I=2*{IQ} + (V(outL)*V(outL) + V(outR)*V(outR))/({RLOAD}*{EFF}*V(bat))\n.tran 0 1.4 0 45u\n.step param VBAT list 3.0 3.7 4.2\n.meas TRAN Ibat_avg AVG I(B_BAT)\n.meas TRAN Ibat_pk  MAX I(B_BAT)\n.meas TRAN PloadL_avg AVG V(outL)*V(outL)/{RLOAD}\n.meas TRAN Vbat_min MIN V(bat)
