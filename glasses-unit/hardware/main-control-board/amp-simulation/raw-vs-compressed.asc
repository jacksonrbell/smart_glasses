Version 4
SHEET 1 1200 800
TEXT 32 32 Left 2 ;Raw vs compressed audio, 2x MAX98357A at 9 dB, 3.7 V battery. Keep in same folder as the PWL .txt files. Results: View > SPICE Error Log
TEXT 32 80 Left 2 !.param VBAT=3.7 RBAT=0.15 GAIN=9 RLOAD=8 EFF=0.88 IQ=2.4m DROP=0.19\n.param VFS={sqrt(2)*pow(10,(2.1+GAIN)/20)}\nV_INR  inR  0  PWL file=test_raw_pwl.txt\nV_INC  inC  0  PWL file=test_compressed_pwl.txt\nV_BR   bR0  0    {VBAT}\nR_BR   bR0  batR {RBAT}\nB_OR   outR 0    V=limit({VFS}*V(inR), -(V(batR)-{DROP}), V(batR)-{DROP})\nR_LR   outR 0    {RLOAD}\nB_IR   batR 0    I=2*{IQ} + 2*V(outR)*V(outR)/({RLOAD}*{EFF}*V(batR))\nV_BC   bC0  0    {VBAT}\nR_BC   bC0  batC {RBAT}\nB_OC   outC 0    V=limit({VFS}*V(inC), -(V(batC)-{DROP}), V(batC)-{DROP})\nR_LC   outC 0    {RLOAD}\nB_IC   batC 0    I=2*{IQ} + 2*V(outC)*V(outC)/({RLOAD}*{EFF}*V(batC))\nB_IDR  idealR 0  V={VFS}*V(inR)\nB_IDC  idealC 0  V={VFS}*V(inC)\nB_CLR  clipR 0   V=if(abs({VFS}*V(inR))>V(batR)-{DROP},1,0)\nB_CLC  clipC 0   V=if(abs({VFS}*V(inC))>V(batC)-{DROP},1,0)\nB_AVR  avgR 0    V=idt(I(B_IR))/(time+1u)\nB_AVC  avgC 0    V=idt(I(B_IC))/(time+1u)\nB_PR   pR 0      V=V(outR)*V(outR)/{RLOAD}\nB_PC   pC 0      V=V(outC)*V(outC)/{RLOAD}\n.tran 0 1.4 0 45u\n.meas TRAN Iavg_raw   AVG I(B_IR)\n.meas TRAN Iavg_comp  AVG I(B_IC)\n.meas TRAN Ipk_raw    MAX I(B_IR)\n.meas TRAN Ipk_comp   MAX I(B_IC)\n.meas TRAN Pch_raw    AVG V(pR)\n.meas TRAN Pch_comp   AVG V(pC)\n.meas TRAN Vrms_raw   RMS V(outR)\n.meas TRAN Vrms_comp  RMS V(outC)\n.meas TRAN Vpk_raw    MAX abs(V(outR))\n.meas TRAN Vpk_comp   MAX abs(V(outC))\n.meas TRAN Clip_raw   AVG V(clipR)\n.meas TRAN Clip_comp  AVG V(clipC)
